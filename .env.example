# Google AI Studio key for the dispatch copilot. Server only.
# Without it, the copilot answers from built-in rules.
GEMINI_API_KEY=

# Optional comma-separated model chain.
# GEMINI_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite

# The tracking server, for live devices. Leave empty for the demo crew only.
# NEXT_PUBLIC_TRACKING_URL=ws://localhost:3710
